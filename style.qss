/* Genel Pencere ve Widget'lar için Beyaz/Açık Tema */
QMainWindow, QWidget {
    background-color: #f8f9fa;
    color: #212529;
}

/* Etiketler (Labels) */
QLabel {
    color: #212529;
    background-color: transparent;
}

/* Butonlar */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #ced4da;
    border-radius: 6px;
    color: #212529;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #e9ecef;
    border-color: #adb5bd;
}

QPushButton:pressed {
    background-color: #dee2e6;
}

/* QStackedWidget ve Sayfalar */
QStackedWidget {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 8px;
}

/* İlerleme Çubukları (QProgressBar) */
QProgressBar {
    border: 1px solid #ced4da;
    border-radius: 6px;
    background-color: #e9ecef;
    text-align: center;
    color: #212529;
}

QProgressBar::chunk {
    background-color: #0d6efd; /* Şık bir mavi tonu */
    border-radius: 5px;
}